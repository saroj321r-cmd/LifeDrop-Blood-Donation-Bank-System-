<%- include("../partials/header",{title:"Dashboard | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">MY DASHBOARD</small><h1>Hello, <span><%=user.name%></span>.</h1><p>Manage your donor profile and donation history.</p></div><a class="btn red" href="/requests/create">Request Blood →</a></section><div class="stats"><div><small>DONOR STATUS</small><b><%=donor?"Active":"Not Registered"%></b></div><div><small>BLOOD GROUP</small><b><%=donor?donor.bloodGroup:(user.bloodGroup||"—")%></b></div><div><small>TOTAL DONATIONS</small><b><%=donor?donor.totalDonations:0%></b></div><div><small>REQUESTS</small><b><a href="/requests/my">View →</a></b></div></div><div class="grid2"><div class="form"><small class="eyebrow">DONOR PROFILE</small><h2><%=donor?"Update details":"Become a donor"%></h2><form action="/donor/register" method="POST"><div class="two"><div><label>Blood group</label><select name="bloodGroup" required><option value="">Select</option><%["A+","A-","B+","B-","AB+","AB-","O+","O-"].forEach(g=>{%><option <%=donor&&donor.bloodGroup===g?"selected":""%>><%=g%></option><%})%></select></div><div><label>Age</label><input name="age" type="number" min="18" max="65" value="<%=donor?donor.age:""%>" required></div></div><div class="two"><div><label>Gender</label><select name="gender"><option>Female</option><option>Male</option><option>Other</option></select></div><div><label>City</label><input name="city" value="<%=donor?donor.city:user.city%>"></div></div><label class="check"><input type="checkbox" name="isAvailable" <%=!donor||donor.isAvailable?"checked":""%>> Available for donation</label><button class="btn red">Save Profile</button></form></div><div class="form"><small class="eyebrow">RECORD DONATION</small><h2>Add a donation</h2><p>Record a completed donation to update history and stock.</p><form action="/donor/donation" method="POST"><label>Units donated</label><input name="units" type="number" min="1" value="1"><label>Location</label><input name="location" placeholder="Donation center"><button class="btn dark full">Record Donation</button></form></div></div><div class="table"><small class="eyebrow">HISTORY</small><h2>Your donations</h2><%if(donations.length){%><table><tr><th>Date</th><th>Blood</th><th>Units</th><th>Location</th></tr><%donations.forEach(d=>{%><tr><td><%=new Date(d.donationDate).toLocaleDateString()%></td><td><b><%=d.bloodGroup%></b></td><td><%=d.units%></td><td><%=d.location||"—"%></td></tr><%})%></table><%}else{%><p class="empty">No donations recorded yet.</p><%}%></div><%- include("../partials/footer") %>
