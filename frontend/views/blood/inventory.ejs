<%- include("../partials/header",{title:"Blood Stock | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">LIVE INVENTORY</small><h1>Blood <span>stock.</span></h1><p>Current blood units available in the system.</p></div></section><div class="blood-grid"><%blood.forEach(x=>{let low=x.unitsAvailable<=x.lowStockLimit;%><div class="blood <%=low?"low":""%>"><b><%=x.bloodGroup%></b><strong><%=x.unitsAvailable%></strong><small>units available</small><em><%=low?"Low stock":"Available"%></em></div><%})%></div><div class="info"><b>Need blood?</b><span>Submit a request and our admin team can review it.</span><a class="btn red" href="/requests/create">Create Request</a></div><%- include("../partials/footer") %>
