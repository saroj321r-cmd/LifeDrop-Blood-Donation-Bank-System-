<%- include("../partials/header",{title:"Manage Requests | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">ADMIN • REQUESTS</small><h1>Blood <span>requests.</span></h1><p>Review and manage patient requirements.</p></div></section><div class="table"><table><tr><th>Patient</th><th>Requester</th><th>Blood</th><th>Units</th><th>Urgency</th><th>Status</th><th>Actions</th></tr><%requests.forEach(r=>{%><tr><td><b><%=r.patientName%></b><small><%=r.hospitalName%></small></td><td><%=r.requester?r.requester.name:"—"%></td><td><b><%=r.bloodGroup%></b></td><td><%=r.unitsRequired%></td><td><span class="badge"><%=r.urgency%></span></td><td><span class="badge"><%=r.status%></span></td><td><%if(r.status==="Pending"){%><form class="inline" method="POST" action="/admin/requests/<%=r._id%>/approve"><button class="mini">Approve</button></form><form class="inline" method="POST" action="/admin/requests/<%=r._id%>/reject"><button class="mini danger">Reject</button></form><%}else if(r.status==="Approved"){%><form class="inline" method="POST" action="/admin/requests/<%=r._id%>/fulfill"><button class="mini">Fulfill</button></form><%}else{%>—<%}%></td></tr><%})%></table></div><%- include("../partials/footer") %>
