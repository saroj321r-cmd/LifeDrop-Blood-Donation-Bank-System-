<%- include("../partials/header",{title:"Admin | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">ADMIN CONTROL CENTER</small><h1>System <span>overview.</span></h1><p>Manage donors, requests and blood inventory.</p></div><a class="btn red" href="/admin/requests">Review Requests →</a></section><div class="stats"><div><small>REGISTERED DONORS</small><b><%=stats.donors%></b></div><div><small>DONATIONS</small><b><%=stats.donations%></b></div><div><small>PENDING REQUESTS</small><b><%=stats.pendingRequests%></b></div><div><small>TOTAL BLOOD UNITS</small><b><%=stats.totalUnits%></b></div></div><div class="table"><small class="eyebrow">INVENTORY CONTROL</small><h2>Blood stock</h2><table><tr><th>Group</th><th>Available</th><th>Low limit</th><th>Update</th></tr><%inventory.forEach(x=>{%><tr><td><b><%=x.bloodGroup%></b></td><td><%=x.unitsAvailable%></td><td><%=x.lowStockLimit%></td><td><form class="inline" method="POST" action="/admin/inventory"><input type="hidden" name="bloodGroup" value="<%=x.bloodGroup%>"><input name="unitsAvailable" type="number" value="<%=x.unitsAvailable%>" min="0"><input name="lowStockLimit" type="number" value="<%=x.lowStockLimit%>" min="0"><button class="mini">Save</button></form></td></tr><%})%></table></div><%- include("../partials/footer") %>
