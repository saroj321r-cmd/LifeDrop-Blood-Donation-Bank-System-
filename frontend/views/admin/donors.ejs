<%- include("../partials/header",{title:"Donors | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">ADMIN • DONORS</small><h1>Community <span>donors.</span></h1><p>Registered donor profiles.</p></div></section><div class="table"><table><tr><th>Donor</th><th>Contact</th><th>Blood</th><th>Age</th><th>City</th><th>Donations</th><th>Available</th></tr><%donors.forEach(d=>{%><tr><td><b><%=d.user?d.user.name:"—"%></b><small><%=d.user?d.user.email:""%></small></td><td><%=d.user?d.user.phone||"—":"—"%></td><td><b><%=d.bloodGroup%></b></td><td><%=d.age%></td><td><%=d.city%></td><td><%=d.totalDonations%></td><td><span class="badge"><%=d.isAvailable?"Yes":"No"%></span></td></tr><%})%></table></div><%- include("../partials/footer") %>
