<%- include("../partials/header",{title:"Request Blood | LifeDrop"}) %><section class="auth"><div class="copy"><small class="eyebrow">BLOOD REQUEST</small><h1>Tell us what<br><span>you need.</span></h1><p>Provide accurate patient and hospital details so the request can be reviewed quickly.</p></div><div class="form"><h2>Create blood request</h2><form action="/requests/create" method="POST"><label>Patient name</label><input name="patientName" required><label>Hospital name</label><input name="hospitalName" required><div class="two"><div><label>Blood group</label><select name="bloodGroup" required><option value="">Select</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div><div><label>Units required</label><input name="unitsRequired" type="number" min="1" value="1" required></div></div><label>Urgency</label><select name="urgency"><option>Normal</option><option>Urgent</option><option>Emergency</option></select><label>Reason / details</label><textarea name="reason" rows="4"></textarea><button class="btn red full">Submit Request →</button></form></div></section><%- include("../partials/footer") %>
