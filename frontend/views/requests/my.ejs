<%- include("../partials/header",{title:"My Requests | LifeDrop"}) %><section class="dash-head"><div><small class="eyebrow">REQUEST HISTORY</small><h1>My <span>requests.</span></h1><p>Track the status of every blood request you submitted.</p></div><a class="btn red" href="/requests/create">New Request →</a></section><div class="table"><table><tr><th>Patient</th><th>Hospital</th><th>Blood</th><th>Units</th><th>Urgency</th><th>Status</th></tr><%requests.forEach(r=>{%><tr><td><b><%=r.patientName%></b></td><td><%=r.hospitalName%></td><td><b><%=r.bloodGroup%></b></td><td><%=r.unitsRequired%></td><td><span class="badge"><%=r.urgency%></span></td><td><span class="badge"><%=r.status%></span></td></tr><%})%></table><%if(!requests.length){%><p class="empty">No requests yet.</p><%}%></div><%- include("../partials/footer") %>
